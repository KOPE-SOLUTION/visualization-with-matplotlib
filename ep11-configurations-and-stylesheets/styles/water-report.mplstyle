# Reusable appearance settings for water-utility reports.
font.size: 11
axes.titlesize: 14
axes.titleweight: bold
axes.labelsize: 11
axes.facecolor: white
axes.edgecolor: 0.35
axes.grid: True
axes.axisbelow: True
axes.spines.top: False
axes.spines.right: False
axes.prop_cycle: cycler('color', ['steelblue', 'darkorange'])
grid.color: 0.75
grid.alpha: 0.45
grid.linewidth: 0.8
grid.linestyle: --
lines.linewidth: 2.6
lines.markersize: 6
legend.frameon: False
legend.fontsize: 10
xtick.labelsize: 10
ytick.labelsize: 10
figure.facecolor: white
savefig.dpi: 160
savefig.transparent: False
